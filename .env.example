# ══════════════════════════════════════════════════════
# GUIDESOFT.WEB — Enterprise AI Agent OS Configuration
# ══════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys

# ── App Configuration ──────────────────────────────────
WEBUI_NAME='GUIDESOFT.WEB'
WEBUI_URL='http://localhost:8080'
WEBUI_SECRET_KEY='change-me-in-production-use-openssl-rand-hex-32'
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=user

# ── CORS ───────────────────────────────────────────────
# For production, set to your exact domain
CORS_ALLOW_ORIGIN='*'
FORWARDED_ALLOW_IPS='*'

# ── Local AI (Ollama) ──────────────────────────────────
OLLAMA_BASE_URL='http://localhost:11434'

# ── OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=''
OPENAI_API_BASE_URL='https://api.openai.com/v1'

# ── Anthropic Claude ───────────────────────────────────
ANTHROPIC_API_KEY=''

# ── Google Gemini ──────────────────────────────────────
GOOGLE_API_KEY=''

# ── Groq (Fast Inference) ──────────────────────────────
GROQ_API_KEY=''

# ── DeepSeek ───────────────────────────────────────────
DEEPSEEK_API_KEY=''

# ── Together AI ────────────────────────────────────────
TOGETHER_API_KEY=''

# ── Mistral ────────────────────────────────────────────
MISTRAL_API_KEY=''

# ── OpenRouter (200+ Models) ───────────────────────────
OPENROUTER_API_KEY=''

# ── Perplexity (Web Search AI) ─────────────────────────
PERPLEXITY_API_KEY=''

# ── Cohere ─────────────────────────────────────────────
COHERE_API_KEY=''

# ── xAI Grok ───────────────────────────────────────────
XAI_API_KEY=''

# ── Azure OpenAI ───────────────────────────────────────
AZURE_OPENAI_API_KEY=''
AZURE_OPENAI_BASE_URL='https://your-resource.openai.azure.com'
AZURE_OPENAI_API_VERSION='2024-02-01'

# ── OpenCode AI (Autonomous Coding Agent) ──────────────
OPENCODE_API_KEY=''
OPENCODE_API_URL='https://api.opencode.ai'

# ── OpenHands (OpenDevin) ──────────────────────────────
OPENHANDS_URL='http://localhost:3000'
OPENHANDS_API_KEY=''

# ── Firecrawl (Web Scraping Agent) ─────────────────────
FIRECRAWL_API_KEY=''

# ── Composio (250+ Tool Integrations) ─────────────────
COMPOSIO_API_KEY=''

# ── Database ────────────────────────────────────────────
# SQLite (default, no config needed)
DATABASE_URL='sqlite:///./data/webui.db'
# PostgreSQL (for production)
# DATABASE_URL='postgresql+asyncpg://user:pass@localhost/guidesoft'

# ── Redis (for caching and queues) ─────────────────────
# REDIS_URL='redis://localhost:6379/0'

# ── OAuth / Social Login ───────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=''
OAUTH_GOOGLE_CLIENT_SECRET=''
OAUTH_GITHUB_CLIENT_ID=''
OAUTH_GITHUB_CLIENT_SECRET=''

# ── Privacy & Telemetry ────────────────────────────────
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# ── Testing ────────────────────────────────────────────
TEST_EMAIL=''
TEST_PASSWORD=''
BASE_URL='http://localhost:5173'
BACKEND_URL='http://localhost:8080'
